# Pruebas de pedidos y reglas de negocio. Antes: seed cargado, servidor corriendo y
# auth.http ejecutado (crea a maria). Usa los productos del seed:
# 1 Pizza muzzarella (9500, stock 20), 2 Pizza napolitana (10500, stock 15).
# Correr en orden. Cada prueba indica el codigo ESPERADO.

@base = http://localhost:8000/api/v1

### 0. Cerrar la sesion que haya quedado abierta
# ESPERADO: 200
POST {{base}}/auth/logout

### 1. Crear pedido sin sesion
# ESPERADO: 401
POST {{base}}/pedidos
Content-Type: application/json

{
  "items": [{ "producto_id": 1, "cantidad": 1 }],
  "forma_pago": "EFECTIVO",
  "direccion_entrega": "San Martín 1234"
}

### 2. Login de maria
# ESPERADO: 200
POST {{base}}/auth/token
Content-Type: application/x-www-form-urlencoded

username=maria&password=Maria1234!

### 3. Pedido sin items
# ESPERADO: 422
POST {{base}}/pedidos
Content-Type: application/json

{
  "items": [],
  "forma_pago": "EFECTIVO",
  "direccion_entrega": "San Martín 1234"
}

### 4. Forma de pago invalida (RN-06)
# ESPERADO: 422
POST {{base}}/pedidos
Content-Type: application/json

{
  "items": [{ "producto_id": 1, "cantidad": 1 }],
  "forma_pago": "TARJETA",
  "direccion_entrega": "San Martín 1234"
}

### 5. Direccion de menos de 5 caracteres (RN-06)
# ESPERADO: 422
POST {{base}}/pedidos
Content-Type: application/json

{
  "items": [{ "producto_id": 1, "cantidad": 1 }],
  "forma_pago": "EFECTIVO",
  "direccion_entrega": "Av"
}

### 6. Producto repetido (RN-01)
# ESPERADO: 400
POST {{base}}/pedidos
Content-Type: application/json

{
  "items": [
    { "producto_id": 1, "cantidad": 1 },
    { "producto_id": 1, "cantidad": 2 }
  ],
  "forma_pago": "EFECTIVO",
  "direccion_entrega": "San Martín 1234"
}

### 7. Stock insuficiente (RN-01)
# ESPERADO: 400
POST {{base}}/pedidos
Content-Type: application/json

{
  "items": [{ "producto_id": 1, "cantidad": 999 }],
  "forma_pago": "EFECTIVO",
  "direccion_entrega": "San Martín 1234"
}

### 8. Producto inexistente
# ESPERADO: 404
POST {{base}}/pedidos
Content-Type: application/json

{
  "items": [{ "producto_id": 99999, "cantidad": 1 }],
  "forma_pago": "EFECTIVO",
  "direccion_entrega": "San Martín 1234"
}

### 9. Falla el segundo item: no se guarda nada (rollback)
# ESPERADO: 404. Despues la prueba 10 muestra que el stock de la pizza 1 no cambio
POST {{base}}/pedidos
Content-Type: application/json

{
  "items": [
    { "producto_id": 1, "cantidad": 2 },
    { "producto_id": 99999, "cantidad": 1 }
  ],
  "forma_pago": "EFECTIVO",
  "direccion_entrega": "San Martín 1234"
}

### 10. Stock de la pizza 1 (anotar el valor)
# ESPERADO: 200
GET {{base}}/productos/1

### 11. Pedido valido
# @name pedido1
# ESPERADO: 201, estado PENDIENTE, total 29500 (2 x 9500 + 1 x 10500), lineas con nombre y precio copiados
POST {{base}}/pedidos
Content-Type: application/json

{
  "items": [
    { "producto_id": 1, "cantidad": 2 },
    { "producto_id": 2, "cantidad": 1 }
  ],
  "forma_pago": "TRANSFERENCIA",
  "direccion_entrega": "San Martín 1234",
  "notas": "Tocar timbre"
}

### 12. Stock de la pizza 1 despues del pedido
# ESPERADO: 200, 2 menos que en la prueba 10
GET {{base}}/productos/1

### 13. Mis pedidos
# ESPERADO: 200 {"total": N, "items": [...]} solo de maria
GET {{base}}/pedidos?skip=0&limit=20

### 14. Detalle propio
# ESPERADO: 200
GET {{base}}/pedidos/{{pedido1.response.body.$.id}}

### 15. Resumen siendo user
# ESPERADO: 403
GET {{base}}/pedidos/resumen

### 16. Cambiar estado siendo user
# ESPERADO: 403
PATCH {{base}}/pedidos/{{pedido1.response.body.$.id}}/estado
Content-Type: application/json

{
  "estado": "EN_PREPARACION"
}

### 17. Segundo pedido para cancelar
# @name pedido2
# ESPERADO: 201
POST {{base}}/pedidos
Content-Type: application/json

{
  "items": [{ "producto_id": 1, "cantidad": 3 }],
  "forma_pago": "EFECTIVO",
  "direccion_entrega": "Belgrano 456"
}

### 18. Cancelar el pedido propio en PENDIENTE (RN-03, RN-04)
# ESPERADO: 200, estado CANCELADO
PATCH {{base}}/pedidos/{{pedido2.response.body.$.id}}/cancelar

### 19. Stock de la pizza 1 despues de cancelar
# ESPERADO: 200, igual que en la prueba 12 (se restituyeron las 3)
GET {{base}}/productos/1

### 20. Cancelar de nuevo (ya no esta PENDIENTE)
# ESPERADO: 400
PATCH {{base}}/pedidos/{{pedido2.response.body.$.id}}/cancelar

### 21. Login del admin
# ESPERADO: 200
POST {{base}}/auth/token
Content-Type: application/x-www-form-urlencoded

username=admin&password=Admin1234!

### 22. El admin intenta cancelar por /cancelar un pedido ajeno
# ESPERADO: 403 (el admin cancela por /estado)
PATCH {{base}}/pedidos/{{pedido1.response.body.$.id}}/cancelar

### 23. Todos los pedidos filtrados por estado
# ESPERADO: 200, solo PENDIENTE
GET {{base}}/pedidos?estado=PENDIENTE

### 24. Estado inexistente en el filtro
# ESPERADO: 422
GET {{base}}/pedidos?estado=ENVIADO

### 25. Detalle de un pedido ajeno siendo admin
# ESPERADO: 200
GET {{base}}/pedidos/{{pedido1.response.body.$.id}}

### 26. Transicion invalida: PENDIENTE a ENTREGADO (RN-02)
# ESPERADO: 400
PATCH {{base}}/pedidos/{{pedido1.response.body.$.id}}/estado
Content-Type: application/json

{
  "estado": "ENTREGADO"
}

### 27. PENDIENTE a EN_PREPARACION
# ESPERADO: 200
PATCH {{base}}/pedidos/{{pedido1.response.body.$.id}}/estado
Content-Type: application/json

{
  "estado": "EN_PREPARACION"
}

### 28. EN_PREPARACION a ENTREGADO
# ESPERADO: 200
PATCH {{base}}/pedidos/{{pedido1.response.body.$.id}}/estado
Content-Type: application/json

{
  "estado": "ENTREGADO"
}

### 29. Estado terminal: ENTREGADO a CANCELADO (RN-02)
# ESPERADO: 400
PATCH {{base}}/pedidos/{{pedido1.response.body.$.id}}/estado
Content-Type: application/json

{
  "estado": "CANCELADO"
}

### 30. Pedido inexistente
# ESPERADO: 404
PATCH {{base}}/pedidos/99999/estado
Content-Type: application/json

{
  "estado": "EN_PREPARACION"
}

### 31. Cambiar el precio de la pizza 1
# ESPERADO: 200
PUT {{base}}/productos/1
Content-Type: application/json

{
  "precio_base": 12000
}

### 32. El pedido entregado conserva el precio original (RN-05)
# ESPERADO: 200, precio_unitario 9500 y total 29500
GET {{base}}/pedidos/{{pedido1.response.body.$.id}}

### 33. Volver el precio a 9500
# ESPERADO: 200
PUT {{base}}/productos/1
Content-Type: application/json

{
  "precio_base": 9500
}

### 34. Resumen del panel
# ESPERADO: 200, entregados >= 1, cancelados >= 1, ingresos_entregados >= 29500
GET {{base}}/pedidos/resumen

### 35. Login de maria
# ESPERADO: 200
POST {{base}}/auth/token
Content-Type: application/x-www-form-urlencoded

username=maria&password=Maria1234!

### 36. Pedido para cancelar como admin desde EN_PREPARACION
# @name pedido3
# ESPERADO: 201
POST {{base}}/pedidos
Content-Type: application/json

{
  "items": [{ "producto_id": 2, "cantidad": 1 }],
  "forma_pago": "EFECTIVO",
  "direccion_entrega": "Mitre 789"
}

### 37. Login del admin
# ESPERADO: 200
POST {{base}}/auth/token
Content-Type: application/x-www-form-urlencoded

username=admin&password=Admin1234!

### 38. PENDIENTE a EN_PREPARACION
# ESPERADO: 200
PATCH {{base}}/pedidos/{{pedido3.response.body.$.id}}/estado
Content-Type: application/json

{
  "estado": "EN_PREPARACION"
}

### 39. EN_PREPARACION a CANCELADO (restituye el stock, RN-03)
# ESPERADO: 200
PATCH {{base}}/pedidos/{{pedido3.response.body.$.id}}/estado
Content-Type: application/json

{
  "estado": "CANCELADO"
}

### 40. Registro de un segundo cliente
# ESPERADO: 201
POST {{base}}/auth/register
Content-Type: application/json

{
  "username": "pedro",
  "full_name": "Pedro López",
  "email": "pedro@example.com",
  "password": "Pedro1234!"
}

### 41. Login de pedro
# ESPERADO: 200
POST {{base}}/auth/token
Content-Type: application/x-www-form-urlencoded

username=pedro&password=Pedro1234!

### 42. Pedro ve el pedido de maria
# ESPERADO: 403
GET {{base}}/pedidos/{{pedido1.response.body.$.id}}

### 43. Pedro cancela el pedido de maria
# ESPERADO: 403
PATCH {{base}}/pedidos/{{pedido3.response.body.$.id}}/cancelar

### 44. Mis pedidos de pedro
# ESPERADO: 200 {"total": 0, "items": []}
GET {{base}}/pedidos
