# Pruebas de auth y usuarios (REST Client de VS Code)
# Antes: base nueva, python -m app.db.seed y el servidor corriendo.
# REST Client guarda la cookie del login y la manda sola en los requests siguientes.
# Correr en orden, de arriba hacia abajo. Cada prueba indica el codigo ESPERADO.

@base = http://localhost:8000/api/v1

### 1. Registro de un cliente
# @name maria
# ESPERADO: 201, role "user" y sin hashed_password
POST {{base}}/auth/register
Content-Type: application/json

{
  "username": "maria",
  "full_name": "María García",
  "email": "maria@example.com",
  "password": "Maria1234!"
}

### 2. Registro con el mismo username (en mayusculas)
# ESPERADO: 409
POST {{base}}/auth/register
Content-Type: application/json

{
  "username": "MARIA",
  "full_name": "Otra María",
  "email": "otra@example.com",
  "password": "Maria1234!"
}

### 3. Registro con el mismo email
# ESPERADO: 409
POST {{base}}/auth/register
Content-Type: application/json

{
  "username": "maria2",
  "full_name": "Otra María",
  "email": "maria@example.com",
  "password": "Maria1234!"
}

### 4. Registro con contraseña de menos de 8 caracteres
# ESPERADO: 422
POST {{base}}/auth/register
Content-Type: application/json

{
  "username": "juan",
  "full_name": "Juan Pérez",
  "email": "juan@example.com",
  "password": "123"
}

### 5. Registro con email invalido
# ESPERADO: 422
POST {{base}}/auth/register
Content-Type: application/json

{
  "username": "juan",
  "full_name": "Juan Pérez",
  "email": "no-es-un-email",
  "password": "Juan1234!"
}

### 6. Cerrar cualquier sesion previa
# ESPERADO: 200
POST {{base}}/auth/logout

### 7. /me sin sesion
# ESPERADO: 401
GET {{base}}/auth/me

### 8. Login con clave incorrecta
# ESPERADO: 401
POST {{base}}/auth/token
Content-Type: application/x-www-form-urlencoded

username=maria&password=incorrecta

### 9. Login de maria
# ESPERADO: 200 {"message": "Login exitoso"} y Set-Cookie access_token HttpOnly (el body no trae el token)
POST {{base}}/auth/token
Content-Type: application/x-www-form-urlencoded

username=maria&password=Maria1234!

### 10. /me de maria
# ESPERADO: 200 con role "user"
GET {{base}}/auth/me

### 11. Listado de usuarios siendo user
# ESPERADO: 403
GET {{base}}/admin/usuarios

### 12. Login del admin del seed
# ESPERADO: 200
POST {{base}}/auth/token
Content-Type: application/x-www-form-urlencoded

username=admin&password=Admin1234!

### 13. /me del admin
# @name yo
# ESPERADO: 200 con role "admin"
GET {{base}}/auth/me

### 14. Listado de usuarios
# ESPERADO: 200, incluye admin y maria
GET {{base}}/admin/usuarios

### 15. El admin intenta desactivarse a si mismo
# ESPERADO: 400
POST {{base}}/admin/usuarios/{{yo.response.body.$.id}}/desactivar

### 16. Desactivar un usuario inexistente
# ESPERADO: 404
POST {{base}}/admin/usuarios/99999/desactivar

### 17. Desactivar a maria
# ESPERADO: 200 con disabled true
POST {{base}}/admin/usuarios/{{maria.response.body.$.id}}/desactivar

### 18. Desactivarla otra vez (idempotente)
# ESPERADO: 200 con disabled true
POST {{base}}/admin/usuarios/{{maria.response.body.$.id}}/desactivar

### 19. Login de maria desactivada
# ESPERADO: 400 "Cuenta de usuario desactivada"
POST {{base}}/auth/token
Content-Type: application/x-www-form-urlencoded

username=maria&password=Maria1234!

### 20. Login del admin de nuevo
# ESPERADO: 200
POST {{base}}/auth/token
Content-Type: application/x-www-form-urlencoded

username=admin&password=Admin1234!

### 21. Activar a maria
# ESPERADO: 200 con disabled false
POST {{base}}/admin/usuarios/{{maria.response.body.$.id}}/activar

### 22. Activar un usuario inexistente
# ESPERADO: 404
POST {{base}}/admin/usuarios/99999/activar

### 23. Logout
# ESPERADO: 200 y Set-Cookie que borra access_token
POST {{base}}/auth/logout

### 24. /me despues del logout
# ESPERADO: 401
GET {{base}}/auth/me
