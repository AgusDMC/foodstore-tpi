# Copiar como .env y completar. El .env no se entrega ni se sube (esta en .gitignore)

# Formato: postgresql://USUARIO:CLAVE@HOST:PUERTO/BASE
DATABASE_URL=postgresql://postgres:CAMBIAR@localhost:5432/foodstore_db

# Firma del JWT: minimo 32 caracteres. Generar una con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido por CORS
FRONTEND_ORIGIN=http://localhost:5173

# Usuario admin que crea python -m app.db.seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin1234!
